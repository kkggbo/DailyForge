# 复制本文件为 deploy/.env 并填入真实值。
# deploy/.env 已被 .gitignore 忽略，不会误提交。

# --- MySQL ---
MYSQL_ROOT_PASSWORD=change_me_root
MYSQL_PASSWORD=change_me_app
# MYSQL_USER=dailyforge
# MYSQL_DATABASE=dailyforge

# --- JWT 密钥 ---
# 用下面命令生成一个强随机值：openssl rand -base64 48
JWT_SECRET=change_me_jwt_secret

# --- DeepSeek AI ---
# 不使用 AI 功能可保持占位值；使用则填入真实 Key。
AI_API_KEY=replace-with-your-ai-api-key
